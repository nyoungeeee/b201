# Copy this file to .env for production, then replace every CHANGE_ME value.
# It can also be used directly for configuration checks:
# docker compose --env-file .env.example config --quiet

B201_ENV_FILE=.env.example
APP_ENV=prod
COMPOSE_PROFILES=prod

SECRET_KEY=CHANGE_ME_django_secret_key
DEBUG=False
ALLOWED_HOSTS=api.b201.kr

DB_NAME=b201
DB_USER=b201
DB_PASSWORD=CHANGE_ME_database_password
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5319

BACKEND_PORT=8000

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://b201.kr,https://admin.b201.kr
CSRF_TRUSTED_ORIGINS=https://b201.kr,https://admin.b201.kr,https://api.b201.kr
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
TIME_ZONE=Asia/Seoul
LANGUAGE_CODE=ko-kr
DJANGO_SETTINGS_MODULE=config.settings.prod

KAKAO_REST_API_KEY=CHANGE_ME_kakao_rest_api_key
KAKAO_REDIRECT_URIS=https://b201.kr/auth/kakao/callback,https://admin.b201.kr/auth/kakao/callback
KAKAO_CLIENT_SECRET=CHANGE_ME_kakao_client_secret

ROOT_ADMIN_ID=1
ROOT_ADMIN_PASSWORD=CHANGE_ME_root_admin_password
