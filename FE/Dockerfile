FROM node:24-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=/api/v1
ARG VITE_KAKAO_REST_API_KEY=
ARG VITE_KAKAO_REDIRECT_URI=
ARG VITE_ACCESS_TOKEN_KEY=accessToken
ARG VITE_REFRESH_TOKEN_KEY=refreshToken
ARG VITE_AUTH_USER_KEY=authUser

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_KAKAO_REST_API_KEY=$VITE_KAKAO_REST_API_KEY
ENV VITE_KAKAO_REDIRECT_URI=$VITE_KAKAO_REDIRECT_URI
ENV VITE_ACCESS_TOKEN_KEY=$VITE_ACCESS_TOKEN_KEY
ENV VITE_REFRESH_TOKEN_KEY=$VITE_REFRESH_TOKEN_KEY
ENV VITE_AUTH_USER_KEY=$VITE_AUTH_USER_KEY

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.29-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 8081
